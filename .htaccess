# Hostinger: compress text files on the way out, and let browsers keep the files in assets/ for
# a year without asking again (their names carry a hash of their content, so a changed file is a
# new name; without this they are re-checked after a week). Each block only applies if the server
# has the module.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/wasm
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2|webp|svg|png|jpg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
