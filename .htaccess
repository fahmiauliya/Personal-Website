# Hostinger: compress text files on the way out. Each block only applies if the server has the
# module. (Cache lifetimes are Hostinger's own, a week for assets/: a Cache-Control header set
# here is overridden by its CDN.)
<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/wasm
</IfModule>
